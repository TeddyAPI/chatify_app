const io = require("socket.io")(3000);

io.on("connection", (socket) => {
  console.log("유저 접속:", socket.id);

  // 1. 방 생성 및 참가 (본인이 방을 만들 때)
  socket.on("create_room", (roomName) => {
    socket.join(roomName);
    console.log(`${socket.id}가 방 [${roomName}]을 생성했습니다.`);
    socket.emit("room_created", roomName);
  });

  // 2. 다른 유저를 방에 초대하기
  // invite_user 이벤트: { targetSocketId: "초대할유저ID", roomName: "방이름" }
  socket.on("invite_user", ({ targetSocketId, roomName }) => {
    const targetSocket = io.sockets.sockets.get(targetSocketId);

    if (targetSocket) {
      targetSocket.join(roomName); // 대상 유저를 방에 강제 조인시킴
      
      // 초대받은 유저에게 알림
      io.to(targetSocketId).emit("invited_to_room", {
        roomName,
        invitedBy: socket.id
      });

      // 방 전체에 새로운 멤버 입장 알림
      io.to(roomName).emit("message", `${targetSocketId}님이 입장하셨습니다.`);
    } else {
      socket.emit("error_message", "유저를 찾을 수 없습니다.");
    }
  });

  // 3. 방에 메시지 보내기
  socket.on("send_message", ({ roomName, message }) => {
    // roomName에 속한 모든 유저에게 메시지 전송 (보낸 사람 포함)
    io.to(roomName).emit("receive_message", {
      sender: socket.id,
      message
    });
  });
});

